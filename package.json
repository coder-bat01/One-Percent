{
  "name": "one-percent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/postbuild.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "backup": "node scripts/backup.mjs",
    "security:smoke": "node scripts/security-smoke.mjs",
    "check:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
