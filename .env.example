# Writable persistent SQLite file; defaults to this path when omitted.
DATABASE_PATH=.data/one-percent.sqlite

# Set true when serving the public app over HTTPS.
# Leave false for plain HTTP on localhost.
COOKIE_SECURE=false

# Optional listen port (default 3000).
# PORT=3000

# Optional bind address for `npm start` (default 0.0.0.0).
# BIND_HOST=0.0.0.0
